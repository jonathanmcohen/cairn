# syntax=docker/dockerfile:1.7
ARG NODE_VERSION=24-alpine

FROM node:${NODE_VERSION} AS base
RUN corepack enable
WORKDIR /app

FROM base AS deps
# See Dockerfile: pnpm-workspace.yaml carries the allowBuilds +
# minimumReleaseAgeExclude policy needed for the in-container frozen install.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

FROM base AS runner
ENV NODE_ENV=production
COPY --from=deps /app/node_modules ./node_modules
COPY package.json tsconfig.json ./
COPY collab ./collab
COPY src/lib/collab ./src/lib/collab
COPY src/lib/auth ./src/lib/auth
# collab/server.ts imports @/lib/observability/metrics (prom-client gauges/
# counters for the Hocuspocus connection + doc-update telemetry). authorize.ts
# pulls @/lib/auth/require-role only as `import type`, which tsx erases — but
# observability/metrics is a value import and must be present at runtime.
COPY src/lib/observability ./src/lib/observability
# v0.9.12 hotfix: collab/server.ts → materialize() imports
# @/lib/flashcards/reconcile-raw, which imports the dependency-free
# @/lib/flashcards/extract. Both must be present at runtime. They are
# deliberately Drizzle-/@db-schema-free so the collab image stays a thin curated
# subset of src — do NOT add the Drizzle-laden reconcile.ts here (it pulls
# @/db/schema, which is intentionally not copied into this image).
COPY src/lib/flashcards/extract.ts src/lib/flashcards/reconcile-raw.ts ./src/lib/flashcards/

RUN addgroup -g 1001 -S cairn && adduser -u 1001 -S cairn -G cairn
USER cairn

EXPOSE 1234
ENV COLLAB_PORT=1234

# Invoke the tsx binary directly — NOT via `pnpm exec`. pnpm 10+ runs a
# dependency-status check before `exec` that writes a temp file into the cwd
# (`/app`); the container runs as the non-root `cairn` user and `/app` is
# root-owned, so that write fails with EACCES and crash-loops the container.
# Going straight to node_modules/.bin/tsx skips pnpm/corepack entirely (no
# deps-check, no network). tsx still resolves the @/ alias via tsconfig paths.
CMD ["node_modules/.bin/tsx", "collab/server.ts"]
