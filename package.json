{
  "name": "cairn",
  "version": "0.8.0",
  "private": true,
  "description": "Self-hosted, Notion-style block-based notes",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build && pnpm build:sw && pnpm build:entrypoint",
    "build:sw": "serwist build serwist.config.mjs",
    "build:entrypoint": "tsc --project tsconfig.entrypoint.json",
    "start": "node dist/server/entrypoint.js",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:a11y": "playwright test --config=playwright.config.ts",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "email:digest": "tsx src/server/digest-cli.ts",
    "i18n:check": "tsx scripts/i18n-audit.ts",
    "i18n:baseline": "rm -f i18n-audit.baseline.json && tsx scripts/i18n-audit.ts",
    "export:static": "tsx scripts/cairn-export.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.7.0",
    "@authenio/samlify-node-xmllint": "^2.0.0",
    "@aws-sdk/client-s3": "^3.1052.0",
