    "@types/plantuml-encoder": "^1.4.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/unzipper": "^0.10.11",
    "@vitest/coverage-v8": "^4.1.7",
    "drizzle-kit": "^0.31.10",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
