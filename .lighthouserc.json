{
  "ci": {
    "collect": {
      "startServerCommand": "rm -rf .next/standalone/.next/static && cp -R .next/static .next/standalone/.next/static && cp -R public .next/standalone/public && node .next/standalone/server.js",
      "startServerReadyPattern": "Ready in",
      "url": ["http://localhost:3000/p/v08-lhci-seed-slug", "http://localhost:3000/api-docs"],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "preset": "lighthouse:no-pwa",
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.85, "aggregationMethod": "median" }],
        "largest-contentful-paint": [
          "warn",
          { "maxNumericValue": 2500, "aggregationMethod": "median" }
        ],
        "first-contentful-paint": [
          "warn",
          { "maxNumericValue": 1800, "aggregationMethod": "median" }
        ],
        "interactive": ["warn", { "maxNumericValue": 3800, "aggregationMethod": "median" }],
        "uses-responsive-images": "off",
        "uses-rel-preconnect": "off",
        "color-contrast": "off",
        "// inapplicable by design": "the lighthouse:no-pwa preset errors on SEO/build audits that don't apply to a self-hosted app: public pages are deliberately robots:noindex (is-crawlable), no robots.txt is served, the standalone build ships source maps + tree-shaken-but-unused vendor JS, and bf-cache is moot for the editor shell. errors-in-console + inspector-issues stay at preset default (error) to keep real-bug signal.",
        "is-crawlable": "off",
        "robots-txt": "off",
        "valid-source-maps": "off",
        "unused-javascript": "off",
        "bf-cache": "off",
        "legacy-javascript-insight": "off",
        "network-dependency-tree-insight": "off"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
