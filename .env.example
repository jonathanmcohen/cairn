# Database
DB_PASSWORD=changeme-postgres-password
DATABASE_URL=postgres://cairn:changeme-postgres-password@db:5432/cairn

# Auth.js
# Generate with: openssl rand -base64 32
AUTH_SECRET=changeme-at-least-32-chars-of-randomness
NEXTAUTH_URL=http://localhost:3000

# Optional
CAIRN_MAX_UPLOAD_MB=25
CAIRN_TRASH_RETENTION_DAYS=30
CAIRN_LOG_LEVEL=info

# File storage backend: local (default) | s3
FILE_BACKEND=local
# Required only when FILE_BACKEND=s3 (MinIO or AWS S3). For the local MinIO
# compose profile: S3_ENDPOINT=http://minio:9000, path-style is forced.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# Public base URL. docker-compose interpolates this into NEXTAUTH_URL (the value
# the container actually sees). The app derives its public origin from
# NEXTAUTH_URL or the incoming request host at runtime — see src/lib/url.ts.
PUBLIC_URL=http://localhost:3000

# TLS reverse proxy (optional — docker-compose.proxy.yml + deploy/Caddyfile).
# Only used when you bring up the stack with `-f docker-compose.proxy.yml`.
# Set to the hostname or IP you reach Cairn at; Caddy terminates HTTPS on :443
# and proxies to the app + collab websocket. When the proxy is on, also move
# PUBLIC_URL/NEXTAUTH_URL to https://<domain> and COLLAB_URL to
# wss://<domain>/collab. See docs/deployment.md.
# CAIRN_DOMAIN=cairn.example.com

# OAuth (optional — providers appear only when both ID + SECRET are set)
# Google: https://console.cloud.google.com/apis/credentials
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# GitHub: https://github.com/settings/developers
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# Collab (real-time editing). Browser-facing WS endpoint for the cairn-collab service.
# Default points at the local dev Hocuspocus port; in a deploy use wss://<host>/collab.
COLLAB_URL=ws://localhost:1234
# Port the cairn-collab container listens on (used by docker-compose).
COLLAB_PORT=1234
# v0.9.15 #A3 — internal HTTP base the app uses to push REST-PATCH content writes
# into the live Yjs doc (so a collab materialize flush can't clobber an API save
# while an editor session is open). Same host:port as the collab service, http
# scheme. On the compose network the service is reachable by name; leave UNSET
# for single-process / no-collab deploys (publish is then disabled and the API
# write simply wins when no Yjs doc is open). Auth reuses AUTH_SECRET.
# CAIRN_COLLAB_INTERNAL_URL=http://cairn-collab:1234

# Cairn image tag for the docker-compose `cairn` + `cairn-collab` services.
# Pin to a specific release (e.g. 0.8.0) for reproducible deploys; omit to
# track `latest`. Both services are version-locked via this single var so
# they never drift across major bumps.
# CAIRN_VERSION=0.8.0

# Scheduled-backup interval (e.g. 24h). OFF by default. SINGLE-INSTANCE ONLY —
# two instances double-fire. Prefer external cron for multi-instance setups.
# See docs/operations.md.
# CAIRN_BACKUP_INTERVAL=

# Native server-side PDF export (v0.8.0 G9 P25). When set to 1, the
# /api/pages/[pageId]/export?format=pdf route returns real application/pdf
# bytes rendered by a headless-Chromium singleton (via @playwright/test,
# which ships in dependencies). Adds ~150MB to the image due to the
# bundled Chromium binary. Leave unset to keep the slim browser-print
# HTML fallback (users save via the browser's print dialog).
CAIRN_NATIVE_PDF=

# End-to-end encryption (v0.9.0 G1 P5-P7). When set to "true", workspace
# admins see the E2E opt-in surfaces (per-page Encrypt action + workspace-wide
# toggle). The server NEVER holds keys regardless — leaving this flag off
# only hides the opt-in UI for self-host operators who don't want the
# feature exposed. Public mirror is inlined into the client bundle.
# CAIRN_ENABLE_E2E_ENCRYPTION=false
# NEXT_PUBLIC_CAIRN_ENABLE_E2E_ENCRYPTION=false

# WebAuthn / passkeys (v0.9.0 G1 P8).
#   CAIRN_RP_ID     = REGISTRABLE DOMAIN ONLY (host, no scheme/port).
#   CAIRN_RP_ORIGIN = FULL ORIGIN (scheme + host + port). MUST match the
#                     origin of NEXTAUTH_URL — a mismatch invalidates every
#                     enrolled passkey permanently. Startup logs a loud
#                     warning if the two diverge.
#   CAIRN_RP_NAME   = Human-readable name shown in the authenticator prompt.
# Leave unset if you do NOT want to expose the /settings/security/passkeys
# enrollment flow; the WebAuthn routes will 503 without these.
# CAIRN_RP_ID=cairn.example.com
# CAIRN_RP_NAME=Cairn
# CAIRN_RP_ORIGIN=https://cairn.example.com

# PlantUML render server (v0.9.0 G3 P15). When unset, the editor and any
# server-side render hooks point at the public service at
# https://www.plantuml.com/plantuml. Set BOTH variables to the same URL when
# self-hosting (https://github.com/plantuml/plantuml-server). The PUBLIC
# variant is inlined into the browser bundle (the editor's <img> view fetches
# directly), so the operator's server must be reachable from end-user clients.
# CAIRN_PLANTUML_SERVER=https://plantuml.example.com
# NEXT_PUBLIC_CAIRN_PLANTUML_SERVER=https://plantuml.example.com

# Chat bridge (G7 #14 — v0.9 P36).
# All values are OPTIONAL. The bridge is workspace-opt-in: admins paste an
# incoming-webhook URL + signing secret / bot token into /admin/chat-bridge,
# and per-workspace creds live in the `webhooks.platform_metadata` jsonb.
# These env vars are placeholders for the OAuth install path deferred to P37.
CAIRN_SLACK_CLIENT_ID=
CAIRN_SLACK_CLIENT_SECRET=
CAIRN_SLACK_SIGNING_SECRET=
CAIRN_DISCORD_CLIENT_ID=
CAIRN_DISCORD_CLIENT_SECRET=
CAIRN_DISCORD_BOT_TOKEN=

# Release-watch daemon (v0.9.0 G8 P42). Polls a GitHub-shaped JSON feed
# (or any mirror with the same shape) on a daily cron and notifies every
# owner/admin when a newer stable tag is published. Auto-apply is OFF —
# the admin button at /settings/admin/upgrade is the only path to
# applyUpgrade. Set CAIRN_RELEASE_WATCH_ENABLED=false for air-gapped
# deploys; the registration is skipped at startup.
# CAIRN_RELEASE_FEED_URL=https://api.github.com/repos/jonathanmcohen/cairn/releases
# CAIRN_RELEASE_WATCH_ENABLED=true
